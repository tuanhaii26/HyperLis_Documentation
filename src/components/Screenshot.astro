---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  title?: string;
}

const {
  src = '/images/hyperlis/placeholder.png',
  alt,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

function resolveSrc(imgSrc: string) {
  if (!imgSrc) return `${baseUrl}/images/hyperlis/placeholder.png`;
  if (imgSrc.startsWith('http://') || imgSrc.startsWith('https://')) return imgSrc;
  if (imgSrc.startsWith(baseUrl)) return imgSrc;
  return `${baseUrl}${imgSrc.startsWith('/') ? imgSrc : `/${imgSrc}`}`;
}

const finalSrc = resolveSrc(src);
const placeholderSrc = `${baseUrl}/images/hyperlis/placeholder.png`;
---

<figure class="hl-screenshot-wrapper">
  <img 
    src={finalSrc} 
    alt={alt} 
    loading="lazy" 
    class="hl-screenshot-img"
    onerror={`if (this.src !== '${placeholderSrc}') { this.src = '${placeholderSrc}'; }`}
  />
</figure>

<style>
  .hl-screenshot-wrapper {
    margin: 1.5rem 0 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .hl-screenshot-img {
    max-width: 100%;
    height: auto;
    max-height: 540px;
    display: block;
    border-radius: 0.5rem;
    object-fit: contain;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  :root[data-theme='dark'] .hl-screenshot-img {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }
</style>
